/**
 * BioInnovate online saving: Google Apps Script
 * ----------------------------------------------
 * Saves each student's BioInnovate progress in this Google Sheet. Nothing is sent anywhere else.
 *
 * SETUP (once, on a computer, about 10 minutes)
 *  1. Create a new Google Sheet and name it "BioInnovate Progress".
 *  2. In the Sheet: Extensions > Apps Script. Delete everything in Code.gs, paste this whole file, and click Save.
 *  3. At the top of the editor, choose the function "setup" and click Run. Allow the permissions it asks for
 *     (choose your account > Advanced > Go to BioInnovate (unsafe) > Allow). This only lets the script use
 *     this Sheet. It creates two tabs: "Progress" and "Settings".
 *  4. In the "Settings" tab, type your section names in column A, one per row, starting at A2
 *     (for example: 12-STEM A). Students will pick their section from this list.
 *  5. Click Deploy > New deployment > the gear icon > Web app.
 *       Description: BioInnovate saving
 *       Execute as: Me
 *       Who has access: Anyone
 *     Click Deploy. Copy the Web app URL (it ends in /exec) and give it to the person who set up the module.
 *
 * EVERY DAY
 *  - Each student has one row. Students who completed at least 75% of the module show "Yes" in "Meets 75%?".
 *  - Forgotten PIN: delete that student's cell in "PIN (stored as a hash)". Their next sign-in sets a new PIN.
 *  - Do not edit the "Data" columns. You may sort or filter the rows.
 *  - If you change this code later, use Deploy > Manage deployments > edit > Version: New version, so the URL stays the same.
 *
 * This file was generated by tools/build.py: the merge rules and the list of tracked items are copied in.
 */

var SHEET = 'Progress', SETTINGS = 'Settings';
var HEAD = ['Section', 'Name', 'Whole module %', 'Lesson 1 %', 'Lesson 2 %', 'Lesson 3 %', 'Lesson 4 %',
  'Right on the first try', 'Meets 75%?', 'Started', 'Last activity', 'Last saved online', 'PIN (stored as a hash)',
  'Data (do not edit)', 'Data, continued', 'Data, continued'];
var COL_PIN = 13, COL_DATA = 14, CHUNK = 45000, CHUNKS = 3;

/*@@MANIFEST@@*/

/*@@MERGE@@*/

/* ------------------------------------------------------------------ run once from the editor */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  progressSheet_();
  var st = ss.getSheetByName(SETTINGS);
  if (!st) {
    st = ss.insertSheet(SETTINGS);
    st.getRange(1, 1, 1, 2).setValues([['Sections (one per row, starting below)', 'Notes']]).setFontWeight('bold');
    st.getRange(2, 2).setValue('Students choose their section from column A. Leave column A empty to let them type it.');
    st.setColumnWidth(1, 280); st.setColumnWidth(2, 520);
  }
  salt_();
  return 'BioInnovate is set up. Now deploy it as a web app.';
}

/* ------------------------------------------------------------------ web app */
function doGet() {
  return json_({ ok: true, app: 'BioInnovate', sections: sections_() });
}
function doPost(e) {
  var out;
  try { out = handle_(JSON.parse(e.postData.contents)); }
  catch (err) { out = { ok: false, error: 'bad_request' }; }
  return json_(out);
}

function handle_(req) {
  req = req || {};
  var section = clean_(req.section, 40), name = clean_(req.name, 60);
  if (!section || name.length < 3) return { ok: false, error: 'missing' };
  var list = sections_();
  if (list.length) {
    var hit = list.filter(function (s) { return key_(s) === key_(section); })[0];
    if (!hit) return { ok: false, error: 'section' };
    section = hit;
  }
  if (req.action === 'signin' && !/^\d{4}$/.test(String(req.pin || ''))) return { ok: false, error: 'missing' };
  if (req.action === 'save' && !/^[0-9a-f]{64}$/.test(String(req.key || ''))) return { ok: false, error: 'signin_again' };
  if (req.action !== 'signin' && req.action !== 'save') return { ok: false, error: 'bad_request' };

  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { ok: false, error: 'busy' };
  try {
    var sh = progressSheet_(), row = findRow_(sh, section, name), stored = null, ph = '';
    if (row) {
      var who = sh.getRange(row, 1, 1, 2).getValues()[0];
      section = clean_(who[0], 40) || section; name = clean_(who[1], 60) || name;  /* as the Sheet has them */
      var cur = sh.getRange(row, COL_PIN, 1, 1 + CHUNKS).getValues()[0];
      ph = String(cur[0] || '');
      var raw = cur.slice(1).map(function (c) { c = String(c || ''); return c.charAt(0) === '~' ? c.slice(1) : c; }).join('');
      try { stored = raw ? JSON.parse(raw) : null; } catch (e) { stored = null; }
    }
    if (req.action === 'signin') {
      var given = pinHash_(String(req.pin));
      if (ph && ph !== given) return { ok: false, error: 'wrong_pin' };
      ph = given;
    } else {
      if (!row || !ph || keyFor_(ph, section, name) !== String(req.key)) return { ok: false, error: 'signin_again' };
    }
    var incoming = req.data && typeof req.data === 'object' ? req.data : {};
    var merged = stored ? bioMerge(stored, incoming) : bioMerge({}, incoming);
    var text = JSON.stringify(merged);
    if (text.length > CHUNK * CHUNKS) return { ok: false, error: 'too_big' };
    var parts = []; /* each part starts with ~ so the Sheet never reads it as a formula or a number */
    for (var i = 0; i < CHUNKS; i++) parts.push(text.slice(i * CHUNK, (i + 1) * CHUNK));
    var s = bioSummary(merged, MANIFEST), now = new Date();
    var vals = [cell_(section), cell_(name), s.pct, s.lessons[1] || 0, s.lessons[2] || 0, s.lessons[3] || 0, s.lessons[4] || 0,
      s.first, s.meets ? 'Yes' : 'No', merged.started ? new Date(merged.started) : '', merged.last ? new Date(merged.last) : '', now, ph].concat(parts.map(function (t) { return t ? '~' + t : ''; }));
    if (row) sh.getRange(row, 1, 1, vals.length).setValues([vals]);
    else sh.appendRow(vals);
    return { ok: true, key: keyFor_(ph, section, name), section: section, name: name, savedAt: now.getTime(), data: merged };
  } finally {
    lock.releaseLock();
  }
}

/* ------------------------------------------------------------------ helpers */
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function clean_(s, n) { return String(s == null ? '' : s).replace(/[\u0000-\u001f]/g, '').replace(/\s+/g, ' ').trim().slice(0, n); }
function key_(s) { return clean_(s, 80).toLowerCase(); }
/* text that a spreadsheet must never read as a formula or a number */
function cell_(s) { s = String(s); return /^[=+\-@]/.test(s) ? "'" + s : s; }
function salt_() {
  var p = PropertiesService.getScriptProperties(), s = p.getProperty('SALT');
  if (!s) { s = Utilities.getUuid() + Utilities.getUuid(); p.setProperty('SALT', s); }
  return s;
}
function sha_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s, Utilities.Charset.UTF_8)
    .map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
}
/* the PIN is kept only as a salted hash; the device key also names the student, so it works for that row alone */
function pinHash_(pin) { return sha_(salt_() + '|pin|' + pin); }
function keyFor_(ph, section, name) { return sha_(salt_() + '|key|' + ph + '|' + key_(section) + '|' + key_(name)); }
function sections_() {
  var st = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SETTINGS);
  if (!st || st.getLastRow() < 2) return [];
  return st.getRange(2, 1, st.getLastRow() - 1, 1).getValues()
    .map(function (r) { return clean_(r[0], 40); }).filter(function (s) { return s; });
}
function progressSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(SHEET);
  if (!sh) {
    sh = ss.insertSheet(SHEET, 0);
    sh.getRange(1, 1, 1, HEAD.length).setValues([HEAD]).setFontWeight('bold').setBackground('#e2f3ea');
    sh.setFrozenRows(1);
    sh.setColumnWidth(1, 110); sh.setColumnWidth(2, 220);
    sh.getRange('J:L').setNumberFormat('yyyy-mm-dd hh:mm');
    sh.getRange('A:B').setNumberFormat('@');
    sh.getRange('M:P').setNumberFormat('@');
    sh.getRange('M:P').setFontColor('#999999');
    sh.setColumnWidths(COL_DATA, CHUNKS, 80);
  }
  return sh;
}
function findRow_(sh, section, name) {
  var last = sh.getLastRow();
  if (last < 2) return 0;
  var v = sh.getRange(2, 1, last - 1, 2).getValues(), a = key_(section), b = key_(name);
  for (var i = 0; i < v.length; i++) if (key_(v[i][0]) === a && key_(v[i][1]) === b) return i + 2;
  return 0;
}
